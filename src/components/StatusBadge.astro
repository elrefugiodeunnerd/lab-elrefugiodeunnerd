---
import { statusMeta, type Status } from '../lib/status';

interface Props {
  status: Status;
}

const { status } = Astro.props;
const meta = statusMeta(status);
---

<span class={`badge badge--${status}`} title={meta.description}>
  {/* Decorative: the label already carries the meaning. */}
  <span class="badge__glyph" aria-hidden="true">{meta.glyph}</span>
  <span class="badge__label">{meta.label}</span>
</span>

<style>
  /*
   * Colour is never the only signal — each status also has its own glyph, so
   * the state survives greyscale printing and colour-blindness.
   */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.15rem var(--space-sm);
    border-radius: var(--radius-sm);
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas,
      monospace;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    border: 1px solid currentcolor;
  }

  .badge__glyph {
    font-size: 0.7em;
    line-height: 1;
  }

  .badge--en-curso {
    color: var(--status-en-curso);
    background: var(--status-en-curso-bg);
  }
  .badge--retomado {
    color: var(--status-retomado);
    background: var(--status-retomado-bg);
  }
  .badge--abandonado-temporalmente {
    color: var(--status-abandonado-temporalmente);
    background: var(--status-abandonado-temporalmente-bg);
  }
  .badge--abandonado-largo-plazo {
    color: var(--status-abandonado-largo-plazo);
    background: var(--status-abandonado-largo-plazo-bg);
  }
  .badge--finalizado {
    color: var(--status-finalizado);
    background: var(--status-finalizado-bg);
  }

  /* The "alive" status gets a slow pulse — the only ambient motion on the page. */
  .badge--en-curso .badge__glyph {
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
