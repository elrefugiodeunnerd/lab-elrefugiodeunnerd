---
import { formatDate, isoDate } from '../lib/sort';

interface Props {
  updates: readonly { date: Date; text: string }[];
}

const { updates } = Astro.props;

// Newest first, whatever order the markdown happens to list them in.
const ordered = [...updates].sort((a, b) => b.date.getTime() - a.date.getTime());
---

{
  ordered.length > 0 && (
    <section class="updates">
      <h3 class="updates__heading">Diario</h3>
      <ol class="updates__list">
        {ordered.map((update) => (
          <li class="updates__item">
            <time class="updates__date" datetime={isoDate(update.date)}>
              {formatDate(update.date)}
            </time>
            <p class="updates__text">{update.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .updates__heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .updates__list {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  /* Timeline rail: a workbench log, not a blog feed. */
  .updates__item {
    position: relative;
    padding-left: var(--space-lg);
    border-left: 1px solid var(--border);
  }

  .updates__item::before {
    content: '';
    position: absolute;
    left: -3.5px;
    top: 0.45em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
  }

  .updates__item:first-child::before {
    background: var(--accent);
  }

  .updates__date {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin-bottom: 0.15rem;
  }

  .updates__text {
    font-size: var(--text-sm);
    line-height: var(--line-normal);
  }
</style>
