---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cover?: ImageMetadata | undefined;
  alt?: string | undefined;
  title: string;
  slug: string;
}

const { cover, alt, title, slug } = Astro.props;

/**
 * Deterministic placeholder for projects without a cover.
 *
 * A tiny string hash picks a hue, so the same project always gets the same
 * colour across builds. Costs no image request and no broken-image box — and
 * because it's generated it reads as intentional rather than missing.
 */
function hue(input: string): number {
  let hash = 0;
  for (let i = 0; i < input.length; i += 1) {
    hash = (hash * 31 + input.charCodeAt(i)) % 360;
  }
  return hash;
}

/** First letters of up to two words: "Arch Linux" -> "AL". */
const initials = title
  .split(/\s+/)
  .filter((word) => /[\p{L}\p{N}]/u.test(word))
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('');

const placeholderHue = hue(slug);
---

<div class="cover">
  {
    cover ? (
      <Image
        src={cover}
        alt={alt ?? title}
        widths={[320, 640, 960]}
        sizes="(max-width: 700px) 100vw, 420px"
        loading="lazy"
        decoding="async"
        class="cover__img"
      />
    ) : (
      /* Decorative: the title sits next to it, so nothing is lost here. */
      <div
        class="cover__placeholder"
        style={`--hue: ${placeholderHue}`}
        aria-hidden="true"
      >
        <span class="cover__initials">{initials}</span>
      </div>
    )
  }
</div>

<style>
  /*
   * Fixed aspect ratio on the wrapper reserves space before the image loads and
   * keeps the grid even regardless of source dimensions.
   */
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .cover__img,
  .cover__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover__placeholder {
    display: grid;
    place-items: center;
    background-image:
      /* blueprint hatching, so the placeholder reads as workshop paper */
      repeating-linear-gradient(
        45deg,
        hsl(var(--hue) 22% 50% / 0.12) 0 2px,
        transparent 2px 9px
      ),
      linear-gradient(
        135deg,
        hsl(var(--hue) 30% 46% / 0.28),
        hsl(calc(var(--hue) + 40) 26% 38% / 0.18)
      );
  }

  .cover__initials {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas,
      monospace;
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: hsl(var(--hue) 20% 40%);
    opacity: 0.7;
  }

  @media (prefers-color-scheme: dark) {
    .cover__initials {
      color: hsl(var(--hue) 30% 78%);
      opacity: 0.55;
    }
  }

  :global(html[data-theme='dark']) .cover__initials {
    color: hsl(var(--hue) 30% 78%);
    opacity: 0.55;
  }

  :global(html[data-theme='light']) .cover__initials {
    color: hsl(var(--hue) 20% 40%);
    opacity: 0.7;
  }
</style>
